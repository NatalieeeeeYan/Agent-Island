{
  "name": "agent-island",
  "version": "0.1.0",
  "private": true,
  "description": "Unified always-on-top monitor for local AI coding agents",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli/dev.ts",
    "start": "tsx src/cli/dev.ts",
    "app:dev": "electron-vite dev",
    "app:build": "electron-vite build",
    "app:preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:renderer": "tsc --noEmit -p src/renderer/tsconfig.json",
    "hooks:install": "tsx src/cli/hooks.ts install",
    "hooks:uninstall": "tsx src/cli/hooks.ts uninstall",
    "hooks:dry": "tsx src/cli/hooks.ts dry"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
